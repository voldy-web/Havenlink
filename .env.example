# Copy this file to ".env" and fill in the values. ".env" is gitignored.
# Front-end variables MUST start with VITE_ and are visible to anyone
# using the site, so never put secrets here.

# Address of the backend API, e.g. http://localhost:4000 (see server/README.md).
# Leave it EMPTY to run the site in demo mode with data kept in the browser.
# It is baked in when the site is built, so rebuild/redeploy after changing it.
VITE_API_URL=
