# Copy this file to ".env" and fill in the values. ".env" is never committed.

# PostgreSQL connection address, e.g. postgres://user:password@localhost:5432/havenlink
DATABASE_URL=

# Set to true if your database address needs SSL (Render's "External" address does).
DATABASE_SSL=false

# A long random secret used to sign login tokens. At least 32 characters in production.
# Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The website address(es) allowed to call this API, comma separated.
CLIENT_ORIGIN=http://localhost:5173

# Port for the API (Render sets this by itself).
PORT=4000

# TESTING ONLY. Set to true to let people move their own reports and orders to the
# next stage (the owner and vendor sides are not built yet). Leave off for real use.
DEMO_TOOLS=false

# --- Email (forgotten-password links). Optional while developing ---
# Use ONE of these. Without a key no email is sent; in development the link is printed in the server window instead.
# Brevo: create a free account at https://brevo.com, then SMTP & API > API keys > Generate a new API key.
BREVO_API_KEY=
# Resend (alternative): https://resend.com > API Keys.
RESEND_API_KEY=
# Who the email comes from, for example: Haven Link <you@gmail.com>
# With Brevo this address must be verified under Senders & IP > Senders (a Gmail address works).
MAIL_FROM=
# The website address used for links in emails. Defaults to the first CLIENT_ORIGIN.
APP_URL=

# --- Continue with Google ---
# The OAuth Client ID from Google Cloud Console (APIs & Services > Credentials). Leave blank to turn Google sign-in off.
GOOGLE_CLIENT_ID=
